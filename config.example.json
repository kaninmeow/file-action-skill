{
  "storage_dir": "/path/to/your/storage/directory",
  "supported_formats": [".jpg", ".jpeg", ".png", ".pdf", ".doc", ".docx"],
  "max_file_size": 10485760,
  "ocr_enabled": true,
  "ocr_language": "chi_sim",
  "auto_backup": true,
  "backup_interval_days": 7,
  "backup_path": "./backups",
  "certificate_types": {
    "获奖证书": ["获奖", "奖励", "奖项", "奖学金", "一等奖", "二等奖", "三等奖", "优秀", "竞赛"],
    "荣誉证书": ["荣誉", "称号", "表彰", "先进", "模范"],
    "资格证书": ["资格", "认证", "证书", "执照", "许可证"],
    "申报材料": ["申报", "申请", "材料", "项目", "计划"],
    "毕业证书": ["毕业", "学位", "学士", "硕士", "博士"],
    "结业证书": ["结业", "培训", "进修"]
  },
  "date_patterns": [
    "(\\d{4})年(\\d{1,2})月(\\d{1,2})日",
    "(\\d{4})年(\\d{1,2})月",
    "(\\d{4})\\.(\\d{1,2})\\.(\\d{1,2})",
    "(\\d{4})-(\\d{1,2})-(\\d{1,2})",
    "(\\d{4})/(\\d{1,2})/(\\d{1,2})"
  ],
  "name_patterns": [
    "([\\u4e00-\\u9fa5]{2,4})\\s*(?:同学|同志|先生|女士)",
    "姓名[：:]\\s*([\\u4e00-\\u9fa5]{2,4})",
    "([\\u4e00-\\u9fa5]{2,4})\\s*在"
  ],
  "issuer_patterns": [
    "颁发[：:]\\s*([\\u4e00-\\u9fa5]+)",
    "([\\u4e00-\\u9fa5]+大学)",
    "([\\u4e00-\\u9fa5]+学院)",
    "([\\u4e00-\\u9fa5]+学校)",
    "([\\u4e00-\\u9fa5]+公司)",
    "([\\u4e00-\\u9fa5]+机构)",
    "([\\u4e00-\\u9fa5]+委员会)",
    "([\\u4e00-\\u9fa5]+部门)"
  ],
  "award_patterns": [
    "([\\u4e00-\\u9fa5]+奖)",
    "([\\u4e00-\\u9fa5]+奖学金)",
    "([\\u4e00-\\u9fa5]+竞赛)",
    "([\\u4e00-\\u9fa5]+荣誉)",
    "([\\u4e00-\\u9fa5]+称号)"
  ]
}